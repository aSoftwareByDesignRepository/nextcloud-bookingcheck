# Copy to .env and adjust for your Docker dev stack (default: 127.0.0.1:8081).
# IMPORTANT: use the same origin the instance reports via `overwritehost`
# (config.php) — Nextcloud canonicalizes URLs to it, so a `localhost` browser
# session loses its cookie when login redirects to `127.0.0.1` and setup loops.
# Load before smoke tests:  set -a && source e2e/.env && set +a

E2E_BASE=http://127.0.0.1:8081
E2E_LOGIN_URL=${E2E_BASE}/index.php/login

# Staff/admin user — must be instance admin or member of bookingcheck_admin.
# Reset locally if needed:
#   docker compose exec -e OC_PASS='…' nextcloud php occ user:resetpassword --password-from-env bc_atlas_e2e
E2E_USER=bc_atlas_e2e
E2E_PASSWORD=change-me-local-only
